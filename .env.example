# Proposed client configuration contract; no app consumes these settings yet.
# EXPO_PUBLIC values are embedded in the app and must contain no secrets.
# Demo is development-only; production builds must reject demo mode.
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform-specific public purchase SDK keys, after integration selection.
EXPO_PUBLIC_PURCHASE_IOS_KEY=
EXPO_PUBLIC_PURCHASE_ANDROID_KEY=
